{
  "nodeEndpoint": "https://api.whatsonchain.com/v1/bsv/main",
  "network": "mainnet",
  "predeterminedLevel": 4,
  "auth": {
    "scheme": "apiKey",
    "apiKeys": ["replace-with-a-configured-key"]
  },
  "rateLimit": {
    "perMinute": 120
  },
  "logLevel": "info",
  "pkiRoot": {
    "provider": "external",
    "comment": "Use provider 'seed' with PKI_ROOT_SEED for test/dev; 'external' defers to a managed/HSM-held root supplied at runtime."
  }
}
